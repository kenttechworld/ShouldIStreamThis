<Window x:Class="ShouldIStreamThis.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShouldIStreamThis.Windows"
        xmlns:vm="clr-namespace:ShouldIStreamThis.ViewModel"
        mc:Ignorable="d"
        Title="Settings" Height="250" Width="400" ResizeMode="NoResize" Background="#262626">

    <Window.DataContext>
        <vm:SettingsViewModel/>
    </Window.DataContext>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Label Content="Client ID:" Width="100"/>
                <TextBox x:Name="ClientIdTextBox" Width="200" Text="{Binding ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Label Content="Client Secret:" Width="100"/>
                <TextBox x:Name="ClientSecretTextBox" Width="200" Text="{Binding ClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <Button Content="{Binding ButtonText, FallbackValue='Save'}" 
                Width="100" 
                Height="30"
                Command="{Binding SaveSettingsCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>

    </Grid>
</Window>
